# Umami Analytics (Optional)
# Read at build time. Set both to add the Umami script to the site.
# If either is unset, the site builds without analytics.

# Your Umami script URL (e.g., https://your-umami-instance.com/script.js)
PUBLIC_UMAMI_SRC=

# Your website ID from Umami dashboard
PUBLIC_UMAMI_WEBSITE_ID=
