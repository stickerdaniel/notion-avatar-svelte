{
	"name": "notion-avatar-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler pages deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "bun run test:unit && bun run test:e2e",
		"release:registry": "jsrepo publish"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@jsrepo/transform-prettier": "8.0.1",
		"@playwright/test": "1.64.1",
		"@shikijs/langs": "4.5.0",
		"@shikijs/themes": "4.5.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "22.20.5",
		"bits-ui": "2.19.5",
		"clsx": "2.1.1",
		"dompurify": "3.4.17",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jsrepo": "3.8.1",
		"mode-watcher": "1.1.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shiki": "4.5.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"svelte-sonner": "1.2.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.4",
		"vitest": "5.0.5",
		"wrangler": "4.151.2"
	},
	"dependencies": {
		"@lucide/svelte": "^1.59.0",
		"runed": "^0.37.0",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^3.0.0"
	}
}
